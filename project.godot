[physics]

3d/physics_engine="Jolt Physics"

[audio]

; Web 播放模式保持 Godot 默认的 Sample：运行时合成的音效（AudioStreamWAV）交给浏览器
; Web Audio 原生播放，与主线程渲染解耦，掉帧时不会丢音。
; 长音频 BGM 在脚本里单独设为 Stream（scripts/audio/bgm.gd）：174 秒的曲子若走
; Sample，每次播放都要把整首解码成 PCM（约 66MB/首）并阻塞主线程。
general/default_playback_type.web=1
; Web 输出缓冲 150ms（默认 50ms）：音乐走引擎混音时给主线程抖动留余量，减少断续
driver/output_latency.web=150

[rendering]

rendering_device/driver.windows="d3d12"
; Web（WebGL2）只能使用 GL Compatibility，必须写完整路径 rendering/renderer/rendering_method
renderer/rendering_method.web="gl_compatibility"
; 软阴影质量：桌面 Soft High(3)，Web 降到 Soft Very Low(1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=1
; 阳光阴影图集：桌面 4096，Web 2048（阴影贴图显存与带宽减半）
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.web=2048
; 各向异性过滤：桌面 16x(4)，Web 关闭(0)
textures/default_filters/anisotropic_filtering_level=4
textures/default_filters/anisotropic_filtering_level.web=0
; 位置光阴影图集：桌面 4096，Web 2048（地图点光源/路灯阴影占大头）
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/atlas_size.web=2048
; 位置光软阴影质量：桌面 Soft Low(2)，Web 降到 Soft Very Low(1)
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.web=1
; 2D MSAA：桌面 2x；Web（GLES3）不支持 2D MSAA，关闭
anti_aliasing/quality/msaa_2d=1
anti_aliasing/quality/msaa_2d.web=0
