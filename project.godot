; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5


[application]

config/name="PolyForge: Ops"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Constants="*res://scripts/data/constants.gd"
WeaponData="*res://scripts/data/weapons.gd"
Economy="*res://scripts/data/economy.gd"
MapData="*res://scripts/data/maps.gd"
MathUtil="*res://scripts/sim/math_util.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/size/window_width_override=1920
window/size/window_height_override=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/ui_bold.tres"

